        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "np.random.seed(7)\n",
        "horas = np.random.uniform(0, 10, 40)              # 40 puntos repartidos al azar\n",
        "nota = 4 + 0.5 * horas + np.random.randn(40) * 0.8   # nota con algo de ruido\n",
        "\n",
        "plt.scatter(horas, nota)\n",
        "plt.xlabel(\"Horas de estudio\")\n",
        "plt.ylabel(\"Nota\")\n",
        "plt.title(\"Horas de estudio y nota\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "def entrenar(learning_rate, epochs):\n",
        "    a = 0.0\n",
        "    b = 0.0\n",
        "    historial = []\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        y_pred = a * horas + b\n",
        "        error = y_pred - nota\n",
        "\n",
        "        da = 2 * np.mean(error * horas)\n",
        "        db = 2 * np.mean(error)\n",
        "\n",
        "        a = a - learning_rate * da\n",
        "        b = b - learning_rate * db\n",
        "\n",
        "        historial.append(np.mean(error ** 2))\n",
        "\n",
        "    return a, b, historial\n",
        "\n",
        "    import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "for lr in [0.1, 0.01, 0.001, 0.00001]:\n",
        "    for ep in [10, 100, 1000]:\n",
        "        a, b, hist = entrenar(lr, ep)\n",
        "        print(f\"LR={lr:<8} epochs={ep:<5} a={a:12.3f} b={b:12.3f} | error final: {hist[-1]:.3f}\")\n",
        "\n",
        "        a, b, hist = entrenar(learning_rate=0.01, epochs=300)\n",
        "\n",
        "epocas = range(0, 300, 10)          # una época de cada 10\n",
        "errores = [hist[i] for i in epocas]\n",
        "\n",
        "plt.scatter(epocas, errores, color=\"green\")\n",
        "plt.xlabel(\"Época\")\n",
        "plt.ylabel(\"Error cuadrático medio\")\n",
        "plt.title(\"El error baja con las épocas\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "a, b, hist = entrenar(learning_rate=0.01, epochs=1000)\n",
        "\n",
        "plt.scatter(horas, nota, label=\"Alumnos\")\n",
        "x_linea = np.linspace(0, 10, 100)\n",
        "plt.plot(x_linea, a * x_linea + b, color=\"red\", label=f\"y = {a:.2f}x + {b:.2f}\")\n",
        "plt.xlabel(\"Horas de estudio\")\n",
        "plt.ylabel(\"Nota\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(f\"Un alumno que estudia 8 horas sacaría: {a * 8 + b:.1f}\")"
      ]
